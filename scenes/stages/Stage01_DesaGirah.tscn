[node name="Sign01_PoskoTengah" parent="Signposts" instance=ExtResource("8_sign")]
position = Vector2(1475, 1580)
sign_title = "Papan Persimpangan Balai Desa"
short_label = "↑ Hutan Kabut & Stage 2
→ Jembatan Sungai
← Rumah Warga & Kebun"
detail_text = "UTARA: Hutan Berkabut (Mpu Bahula, Sambiloto, Kecubung & Gerbang Stage 2). TIMUR: Aliran Sungai & 2 Jembatan Kayu (Akar Alang-Alang, Meniran, Temulawak, Pegagan). BARAT: Pemukiman warga & kebun herbal dapur. Tekan [R] kapan saja untuk membuka Kuali Portabel!"

[node name="Sign02_PersimpanganUtara" parent="Signposts" instance=ExtResource("8_sign")]
position = Vector2(1475, 955)
sign_title = "Papan Perbatasan Utara Desa"
short_label = "↑ Batas Kabut (Tekan Tab)
→ Sungai Utara  |  ← Rumah Sari"
detail_text = "Di utara terdapat Batas Kabut Teluh menuju Pinggiran Hutan Berkabut. Tekan [Tab] untuk mengendalikan Mpu Bahula menerobos kabut, mengalahkan Bayangan Kabut, dan memanen Sambiloto."

[node name="Sign03_JembatanSelatan" parent="Signposts" instance=ExtResource("8_sign")]
position = Vector2(2385, 1740)
sign_title = "Papan Jembatan Kayu Selatan"
short_label = "→ Seberangi Jembatan
Pegagan & Meniran"
detail_text = "Tepi lembap di seberang sungai ditumbuhi Pegagan dan Meniran alami, sementara sisi barat sungai kaya Temulawak dan Akar Alang-Alang."

[node name="Sign04_HutanUtara" parent="Signposts" instance=ExtResource("8_sign")]
position = Vector2(1475, 595)
sign_title = "Papan Jalan Hutan Utara"
short_label = "↑ Gerbang Stage 2
← Sambiloto  |  Kecubung →"
detail_text = "Lurus ke utara menuju Gerbang Stage 2 (Hutan Bambu & Sendang Girah) yang terbuka setelah seluruh 4 warga Desa Girah sembuh. Hati-hati terhadap 3 Bayangan Kabut dan tanaman Kecubung Gunung bertag TOKSIK!"

