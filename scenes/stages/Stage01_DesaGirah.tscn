[node name="Signposts" type="Node2D" parent="."]

[node name="Sign01_BalaiDesa" parent="Signposts" instance=ExtResource("9_sign")]
position = Vector2(1460, 3590)
sign_title = "Papan Balai Desa Girah"
short_label = "↑ Jalan Utama ke Stage 2
← Pak Kartono & Mbok Sari
Tahan [Shift] untuk Sprint!"
detail_text = "Starter Pack Anda (Kunyit x2, Asam Jawa x2) cukup untuk 2 dosis obat Pak Kartono di barat laut Balai Desa! Jalan setapak utama ke utara aman bagi Tabib hingga Gerbang Stage 2, sedangkan semak hutan di kiri/kanan khusus Mpu Bahula [Tab]."

[node name="Sign02_PerbatasanHutan" parent="Signposts" instance=ExtResource("9_sign")]
position = Vector2(1410, 2795)
sign_title = "Papan Gerbang Koridor Hutan"
short_label = "↑ Koridor Aman Jalan Utama
Luar Jalan = Hutan Liar [Tab]"
detail_text = "Jalan setapak utama lurus ke utara aman dilewati Tabib hingga Gerbang Stage 2 dan tidak bisa dimasuki hewan buas. Untuk masuk ke semak & landmark hutan di kiri/kanan jalan, tekan [Tab] mengutus Mpu Bahula!"

[node name="Sign03_SimpangHutanSelatan" parent="Signposts" instance=ExtResource("9_sign")]
position = Vector2(1556, 2005)
sign_title = "Papan Persimpangan Hutan Selatan"
short_label = "↑ Hutan Dalam & Stage 2
← Rumpun Bambu | Tepi Sungai →"
detail_text = "BARAT (luar jalan): Rumpun Bambu Lebat (Jahe Merah, Daun Sirih, Kencur — dijaga Babi Hutan Liar). TIMUR (luar jalan): Tepi Sungai & 2 Jembatan Kayu (Temulawak, Pegagan, Meniran — dijaga Ular Berbisa). Tekan [Tab] untuk mengutus Mpu Bahula!"

[node name="Sign04_SimpangHutanUtara" parent="Signposts" instance=ExtResource("9_sign")]
position = Vector2(1556, 935)
sign_title = "Papan Persimpangan Hutan Dalam"
short_label = "↑ Gerbang Stage 2
← Reruntuhan | Sarang Babi →"
detail_text = "BARAT (luar jalan): Reruntuhan Batu Tua (Sambiloto, Akar Alang-Alang, Melati — dijaga Ular Berbisa). TIMUR (luar jalan): Sarang Babi Hutan (Sambiloto, Kecubung [! TOKSIK], Serai — dijaga Babi Hutan Liar). Lurus utara: Gerbang Stage 2."

[node name="Sign05_JembatanSungai" parent="Signposts" instance=ExtResource("9_sign")]
position = Vector2(2320, 2170)
sign_title = "Papan Jembatan Kayu Hutan"
short_label = "→ Jembatan Kayu Selatan
Pegagan & Meniran di Seberang"
detail_text = "Seberangi jembatan kayu ini untuk memetik Meniran dan Pegagan di tepi timur sungai, atau naik ke utara menuju Sarang Babi Hutan. Waspadai Ular Berbisa yang lincah!"

